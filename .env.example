# Copy to .env at the repo root and fill in real values:
#     cp .env.example .env && chmod 600 .env
# .env is gitignored — never commit real credentials.

# --- Jenkins health check (scripts/ci-cd/check-jenkins-health.sh) ---

# Base URL of your Jenkins controller, no trailing slash.
JENKINS_URL=https://jenkins.example.com

# API auth. Create the token in Jenkins: your user > Security > API Token.
# Use an API token, not your password.
JENKINS_USER=your-username
JENKINS_API_TOKEN=your-api-token

# Optional: access key for the Metrics plugin healthcheck endpoint
# (Manage Jenkins > Configure System > Metrics). Leave unset to skip.
#JENKINS_METRICS_KEY=

# Optional: set to true only if your Jenkins uses a self-signed cert.
#JENKINS_INSECURE=false

# Optional threshold overrides — defaults shown.
#QUEUE_WARN=10
#QUEUE_CRIT=25
#QUEUE_AGE_WARN_MIN=30
#RESPONSE_WARN_MS=3000
#DISK_WARN_GB=5
